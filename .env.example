# Copia este archivo a .env (no se versiona) y ajusta los valores.
# Credenciales solo para el PostGIS local de docker compose.
POSTGRES_USER=barrio
POSTGRES_PASSWORD=cambia_esta_clave_local
POSTGRES_DB=barrio
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Orígenes permitidos por CORS (JSON).
CORS_ORIGINS=["http://localhost:5173"]
ENVIRONMENT=development

# Sesión JWT (H21, D58). En producción es obligatoria y de 32 caracteres o más;
# genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vacía en desarrollo: se usa una clave aleatoria por proceso.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Cuenta de administración para la evaluación del curso (permisos completos en
# los 14 CRUD). Se crea con: python -m etl.runner --solo admin
# Cámbiala fuera de la evaluación. Los visitantes crean su cuenta en /auth/register.
ADMIN_EMAIL=admin@eltintal.local
ADMIN_PASSWORD=MiniMarie-Admin-2026
ADMIN_NOMBRE=Administración Reconoce tu Barrio

# Chat de Mini Marie (H22, D59). analitico = Local (por defecto, sin internet ni
# claves); generativo = Nube (Claude redacta sobre los datos del barrio); moe =
# Híbrido (lo espacial y la historia locales, la conversación con Claude).
# Sin ANTHROPIC_API_KEY, generativo y moe responden con el modelo analítico.
CHAT_MODEL=analitico
ANTHROPIC_API_KEY=
CHAT_LLM_MODEL=claude-opus-5-5
