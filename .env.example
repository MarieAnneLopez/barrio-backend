# Copia este archivo a .env (no se versiona) y ajusta los valores.
# Este archivo NO contiene secretos reales: solo valores de ejemplo para el
# computador local. En producción cada valor se pone en el panel del hosting
# (ver DEPLOY.md), nunca aquí.

# Base de datos local (PostGIS de docker compose). La clave es solo local.
POSTGRES_USER=barrio
POSTGRES_PASSWORD=cambia_esta_clave_local
POSTGRES_DB=barrio
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# En producción, en su lugar: DATABASE_URL=<cadena del proveedor, con sslmode=require>
DATABASE_URL=

# Orígenes permitidos por CORS (lista JSON).
CORS_ORIGINS=["http://localhost:5173"]
# development | test | production (production apaga /docs y exige JWT_SECRET).
ENVIRONMENT=development

# Sesión JWT (H21, D58). Vacía en desarrollo: se usa una clave aleatoria por
# proceso. En producción es obligatoria (32 caracteres o más); se genera con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# CUENTA DE DEMOSTRACIÓN (desechable, D62). Solo para probar la app en el
# computador local y para la evaluación del curso: permisos completos en los 14
# CRUD. Se crea con: python -m etl.runner --solo admin
# No es una cuenta real ni protege nada real. En producción ADMIN_PASSWORD debe
# ser otra: la API rechaza esta clave cuando ENVIRONMENT=production.
ADMIN_EMAIL=admin@eltintal.local
ADMIN_PASSWORD=MiniMarie-Admin-2026
ADMIN_NOMBRE=Administración Reconoce tu Barrio

# Chat de Mini Marie (H22, D59). analitico = Local (por defecto, sin internet ni
# claves); generativo = Nube (Claude redacta sobre los datos del barrio); moe =
# Híbrido. Sin ANTHROPIC_API_KEY, generativo y moe responden con el analítico.
# La clave real nunca va en este archivo.
CHAT_MODEL=analitico
ANTHROPIC_API_KEY=
CHAT_LLM_MODEL=claude-opus-5-5
# Límites por visitante: por minuto y por sesión de una hora.
CHAT_MESSAGES_PER_MINUTE=30
CHAT_MESSAGES_PER_HOUR=120

# Proxy del frontend publicado (Cloudflare Pages): la misma clave va en el
# panel de Pages. Vacía en local.
PROXY_SECRET=

# Solo para un arreglo puntual en producción: módulos a recargar en el próximo
# arranque (coma), p. ej. datos-catastrales. Quitarla después: recargar cambia los id.
RESEED_MODULES=
