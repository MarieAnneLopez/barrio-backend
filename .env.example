# Copia este archivo a .env (no se versiona) y ajusta los valores.
# Credenciales solo para el PostGIS local de docker compose.
POSTGRES_USER=barrio
POSTGRES_PASSWORD=cambia_esta_clave_local
POSTGRES_DB=barrio
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Orígenes permitidos por CORS (JSON).
CORS_ORIGINS=["http://localhost:5173"]
ENVIRONMENT=development
